# Netlify custom headers
# https://docs.netlify.com/routing/headers/
#
# Mục tiêu: đảm bảo index.html LUÔN được trình duyệt hỏi lại server (không
# tự phục vụ bản cũ từ HTTP cache), để mỗi lần deploy mới, user luôn nhận
# được bản index.html mới nhất ngay khi có mạng. Service worker (sw.js)
# vẫn hoạt động bình thường bên trên lớp này để phục vụ offline khi mất mạng.

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# sw.js cũng nên luôn được hỏi lại mới, để trình duyệt phát hiện kịp thời
# khi bạn cập nhật service worker (vd sau này đổi VERSION).
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
